/* Runs only <app-date-picker>'s specs. Several older specs in this library
   don't compile yet, which would otherwise block these from running.

   "@angular/*": this project folder may have its own partial node_modules/@angular
   (core, common, cdk). The test runner sets TestBed up with that copy, so every
   import must use it too, or TestBed sees two Angulars. Without that folder the
   mapping finds nothing and the workspace copy is used. Paths are relative to this file. */
{
  "extends": "./tsconfig.spec.json",
  "compilerOptions": {
    "paths": {
      "@angular/*": ["./node_modules/@angular/*"],
      "verben-ng-ui/*": ["./*"],
      "verben-ng-ui": ["../../dist/verben-ng-ui"]
    }
  },
  "include": ["src/lib/components/date-picker/**/*.spec.ts", "**/*.d.ts"]
}
